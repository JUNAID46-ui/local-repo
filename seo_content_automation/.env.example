# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Cloud / Sheets
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
GOOGLE_SHEET_ID=your-google-sheet-id-here
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id-here

# Schedule
SCHEDULE_TIMEZONE=Asia/Karachi
SCHEDULE_HOUR=18
SCHEDULE_MINUTE=0

# Content settings
MAX_ARTICLES_PER_BUSINESS=5
TARGET_KEYWORD_DENSITY=2.0
MAX_REVISION_ATTEMPTS=3
META_DESCRIPTION_MIN_LENGTH=140
META_DESCRIPTION_MAX_LENGTH=160

# Image settings
FEATURED_IMAGES=1
SUPPORTING_IMAGES=3

# Model settings
PRIMARY_MODEL=claude-sonnet-4-20250514
RESEARCH_MODEL=claude-sonnet-4-20250514
VALIDATION_MODEL=claude-haiku-4-5-20251001

# Output
OUTPUT_DIR=output
LOG_DIR=logs
DATA_DIR=data
